@using Json.Schema
@* Formulario generado a partir de un JSON Schema (draft 2020-12). Valida en el navegador con el mismo schema que usa la API. *@

@if (_context is not null)
{
    @if (_context.Errors.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" data-testid="schema-errors">
            <b>@ErrorCount() problema(s) por corregir:</b>
            <ul class="mb-0">
                @foreach (var (path, messages) in _context.Errors.Take(8))
                {
                    @foreach (var message in messages)
                    {
                        <li><code>@(path.Length == 0 ? "/" : path)</code>: @message</li>
                    }
                }
            </ul>
        </MudAlert>
    }

    <SchemaField Ctx="_context" Schema="_context.Root" RootValue="Document" Path="" Required="true" />
}

@code {
    private SchemaContext? _context;
    private JsonSchema? _schema;
    private string? _loadedSchema;

    /// <summary>Texto del JSON Schema.</summary>
    [Parameter, EditorRequired] public string SchemaText { get; set; } = string.Empty;

    /// <summary>Documento que se edita en el lugar.</summary>
    [Parameter, EditorRequired] public JsonObject Document { get; set; } = default!;

    [Parameter] public Func<string, IReadOnlyList<FieldOption>?>? OptionsFor { get; set; }

    /// <summary>Propiedades de primer nivel que no se pueden editar (p. ej. "id" de un documento existente).</summary>
    [Parameter] public IEnumerable<string> LockedProperties { get; set; } = [];

    [Parameter] public EventCallback<bool> ValidityChanged { get; set; }

    public bool IsValid => _context?.Errors.Count == 0;

    public IReadOnlyDictionary<string, List<string>> Errors => _context?.Errors ?? new Dictionary<string, List<string>>();

    protected override void OnParametersSet()
    {
        if (_loadedSchema != SchemaText || _context is null)
        {
            _loadedSchema = SchemaText;
            _schema = JsonSchema.FromText(SchemaText);
            _context = new SchemaContext((JsonObject)JsonNode.Parse(SchemaText)!) { OptionsFor = OptionsFor };
            _context.OnChanged = OnChanged;
        }

        _context.LockedPaths.Clear();
        foreach (var property in LockedProperties)
        {
            _context.LockedPaths.Add(SchemaContext.Child(string.Empty, property));
        }

        Validate();
    }

    /// <summary>Valida el documento completo y reparte los errores por ruta.</summary>
    public bool Validate()
    {
        if (_context is null || _schema is null)
        {
            return false;
        }

        _context.Errors.Clear();
        var results = _schema.Evaluate(Document, new EvaluationOptions { OutputFormat = OutputFormat.List });
        if (!results.IsValid)
        {
            Collect(results);
            if (_context.Errors.Count == 0)
            {
                Add(string.Empty, "El documento no cumple el schema.");
            }
        }

        return _context.Errors.Count == 0;
    }

    private void Collect(EvaluationResults results)
    {
        if (results.Errors is not null)
        {
            foreach (var (_, message) in results.Errors)
            {
                Add(results.InstanceLocation.ToString(), message);
            }
        }

        foreach (var detail in results.Details)
        {
            Collect(detail);
        }
    }

    private void Add(string path, string message)
    {
        if (!_context!.Errors.TryGetValue(path, out var list))
        {
            list = [];
            _context.Errors[path] = list;
        }

        if (!list.Contains(message))
        {
            list.Add(message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _context is not null)
        {
            // La página que contiene el formulario conoce la validez inicial (p. ej. para habilitar "Guardar").
            await ValidityChanged.InvokeAsync(IsValid);
        }
    }

    private int ErrorCount() => _context?.Errors.Sum(e => e.Value.Count) ?? 0;

    private void OnChanged()
    {
        var wasValid = IsValid;
        Validate();
        StateHasChanged();
        if (wasValid != IsValid)
        {
            _ = ValidityChanged.InvokeAsync(IsValid);
        }
    }
}
