@page "/despensa"
@inherits AppPage

<PageTitle>Despensa y básicos</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Despensa y básicos</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Outlined="true" Class="pa-4 h-100">
            <MudText Typo="Typo.h6">Lo que siempre tienes</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Se separa de la lista de compras en "Ya tienes".</MudText>
            <div class="d-flex flex-wrap gap-1 mb-2" data-testid="pantry-chips">
                @foreach (var id in _pantry.IngredientIds)
                {
                    <MudChip T="string" OnClose="() => RemoveFromPantry(id)">@Name(id)</MudChip>
                }
            </div>
            <div class="d-flex gap-2 align-center">
                <MudSelect T="string" @bind-Value="_toPantry" Label="Agregar ingrediente" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var ingredient in _ingredients.Where(i => !_pantry.IngredientIds.Contains(i.Id)))
                    {
                        <MudSelectItem T="string" Value="@ingredient.Id">@ingredient.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Add" Disabled="@(_toPantry is null)" OnClick="AddToPantry" aria-label="Agregar" />
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" Disabled="Busy" OnClick="SavePantry">Guardar despensa</MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Outlined="true" Class="pa-4 h-100">
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.h6">Lo que compras seguido</MudText>
                <MudSpacer />
                <MudSelect T="int" Value="_months" ValueChanged="SetMonths" Label="Periodo" Margin="Margin.Dense" Dense="true" Style="max-width: 140px">
                    <MudSelectItem T="int" Value="3">3 meses</MudSelectItem>
                    <MudSelectItem T="int" Value="6">6 meses</MudSelectItem>
                    <MudSelectItem T="int" Value="12">12 meses</MudSelectItem>
                </MudSelect>
            </div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Según tus listas de Keep (semanas en que lo compraste).</MudText>
            @if (_suggestions.Count == 0)
            {
                <MudText Typo="Typo.body2">Sin historial de compras. Importa tus notas en <MudLink Href="importar">Importar Keep</MudLink>.</MudText>
            }
            @foreach (var s in _suggestions.Take(20))
            {
                <div class="d-flex align-center gap-2 mb-1">
                    <div style="width: 45%"><MudText Typo="Typo.body2">@s.Name</MudText></div>
                    <MudProgressLinear Value="@(s.Share * 100)" Color="Color.Primary" Style="width: 25%" />
                    <MudText Typo="Typo.caption">@s.WeeksBought/@s.WeeksInWindow sem</MudText>
                    <MudSpacer />
                    @if (s.IngredientId is not null && !_pantry.IngredientIds.Contains(s.IngredientId))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => AddSuggestion(s.IngredientId)">A despensa</MudButton>
                    }
                    else if (s.IngredientId is null)
                    {
                        <MudTooltip Text="No está en el catálogo de ingredientes"><MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" /></MudTooltip>
                    }
                </div>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Outlined="true" Class="pa-4" data-testid="cookable">
            <MudText Typo="Typo.h6">¿Qué puedo cocinar con lo que tengo?</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                Recetas ordenadas por qué tanto de sus ingredientes ya sueles tener (despensa, básicos y lo que compras seguido).
                Para platillos <b>nuevos</b>, pídeselos a Claude Desktop con el prompt <i>sugerir_platillo</i>.
            </MudText>
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>Receta</th><th>Ya tienes</th><th>Falta comprar</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _cookable)
                    {
                        <tr>
                            <td><MudLink Href="@($"recetas/{r.RecipeId}")">@r.Name</MudLink>@if (r.KcalPerServing is { } kcal) {<MudText Typo="Typo.caption" Class="mud-text-secondary"> · ≈ @kcal.ToString("0") kcal/porción</MudText>}</td>
                            <td style="min-width: 140px"><MudProgressLinear Value="@(r.Coverage * 100)" Color="@(r.Coverage >= 0.7 ? Color.Success : Color.Primary)" /><MudText Typo="Typo.caption">@r.Coverage.ToString("P0")</MudText></td>
                            <td><MudText Typo="Typo.caption">@(r.Missing.Count == 0 ? "Nada" : string.Join(", ", r.Missing))</MudText></td>
                            <td>
                                @if (_inDraft.Contains(r.RecipeId))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">En el menú</MudChip>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => AddToMenu(r.RecipeId)" data-testid="add-to-menu">Al menú</MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Outlined="true" Class="pa-4">
            <MudText Typo="Typo.h6">Básicos semanales</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Se suman a la lista de compras cada semana (desayunos y cenas habituales). La colación del plan ya está incluida:
                @string.Join(", ", _planBasics)
            </MudText>
            <MudSimpleTable Dense="true" Class="mt-2" data-testid="basics-table">
                <thead><tr><th>Ingrediente</th><th>Tiempo de comida</th><th>Cantidad por día</th><th>Unidad</th><th>Días por semana</th><th></th></tr></thead>
                <tbody>
                    @foreach (var basic in _basics.Items)
                    {
                        <tr>
                            <td>
                                <MudSelect T="string" @bind-Value="basic.IngredientId" Margin="Margin.Dense" Dense="true">
                                    @foreach (var ingredient in _ingredients)
                                    {
                                        <MudSelectItem T="string" Value="@ingredient.Id">@ingredient.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </td>
                            <td>
                                <MudSelect T="string" @bind-Value="basic.Meal" Margin="Margin.Dense" Dense="true">
                                    @foreach (var meal in new[] { Meals.Desayuno, Meals.Colacion, Meals.Snack, Meals.Cena })
                                    {
                                        <MudSelectItem T="string" Value="@meal">@meal</MudSelectItem>
                                    }
                                </MudSelect>
                            </td>
                            <td><MudNumericField T="double" @bind-Value="basic.QtyPerDay" Min="0.25" Step="0.25" Margin="Margin.Dense" /></td>
                            <td>
                                <MudSelect T="Unit" @bind-Value="basic.Unit" Margin="Margin.Dense" Dense="true" ToStringFunc="Formatting.Unit">
                                    @foreach (var unit in Enum.GetValues<Unit>().Where(u => u != Unit.Porcion))
                                    {
                                        <MudSelectItem T="Unit" Value="@unit">@Formatting.Unit(unit)</MudSelectItem>
                                    }
                                </MudSelect>
                            </td>
                            <td><MudNumericField T="int" @bind-Value="basic.DaysPerWeek" Min="1" Max="7" Margin="Margin.Dense" /></td>
                            <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => _basics.Items.Remove(basic)" aria-label="Quitar" /></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            <div class="d-flex gap-2 mt-2">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="AddBasic">Agregar básico</MudButton>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Busy" OnClick="SaveBasics">Guardar básicos</MudButton>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private Pantry _pantry = new();
    private BasicsConfig _basics = new();
    private List<Ingredient> _ingredients = [];
    private List<PantrySuggestion> _suggestions = [];
    private List<CookableRecipe> _cookable = [];
    private HashSet<string> _inDraft = [];
    private List<string> _planBasics = [];
    private string? _toPantry;
    private int _months = 6;

    protected override Task OnInitializedAsync() => Run(async () =>
    {
        _ingredients = (await Api.ListIngredientsAsync()).OrderBy(i => i.Name).ToList();
        _pantry = await Api.GetPantryAsync();
        _basics = await Api.GetBasicsAsync();
        _suggestions = await Api.GetPantrySuggestionsAsync(_months, 0.25);
        _cookable = await Api.GetCookableAsync();
        await LoadDraftAsync();
        var plan = (await Api.ListPlansAsync()).FirstOrDefault(p => p.Active);
        _planBasics = plan?.WeeklyBasics.Select(b => $"{Name(b.IngredientId)} {b.QtyPerDay} {Formatting.Unit(b.Unit)}/día").ToList() ?? [];
    });

    private string Name(string id) => _ingredients.FirstOrDefault(i => i.Id == id)?.Name ?? id;

    private void AddToPantry()
    {
        if (_toPantry is not null && !_pantry.IngredientIds.Contains(_toPantry))
        {
            _pantry.IngredientIds.Add(_toPantry);
        }

        _toPantry = null;
    }

    private void RemoveFromPantry(string id) => _pantry.IngredientIds.Remove(id);

    private Task AddSuggestion(string id)
    {
        _pantry.IngredientIds.Add(id);
        return SavePantry();
    }

    private Task SavePantry() => Run(async () =>
    {
        _pantry = await Api.SavePantryAsync(_pantry);
        _cookable = await Api.GetCookableAsync();
    }, "Despensa guardada.");

    private async Task LoadDraftAsync()
    {
        var draft = (await Api.ListMenusAsync()).FirstOrDefault(m => m.Status == MenuStatus.Draft);
        _inDraft = draft is null ? [] : (await Api.GetMenuAsync(draft.Id)).Dishes.Select(d => d.RecipeId).ToHashSet();
    }

    private Task AddToMenu(string recipeId) => Run(async () =>
    {
        var draft = (await Api.ListMenusAsync()).FirstOrDefault(m => m.Status == MenuStatus.Draft)
            ?? throw new ApiException("No hay un menú en borrador: genera uno primero.", 400, []);
        await Api.AddDishAsync(draft.Id, recipeId);
        _inDraft.Add(recipeId);
    }, "Agregado al menú en borrador.");

    private Task SetMonths(int months)
    {
        _months = months;
        return Run(async () => _suggestions = await Api.GetPantrySuggestionsAsync(_months, 0.25));
    }

    private void AddBasic() =>
        _basics.Items.Add(new WeeklyBasic { Meal = Meals.Desayuno, IngredientId = _ingredients.FirstOrDefault()?.Id ?? string.Empty, QtyPerDay = 1, Unit = Unit.Pieza, DaysPerWeek = 7 });

    private Task SaveBasics() => Run(async () => _basics = await Api.SaveBasicsAsync(_basics), "Básicos guardados.");
}
