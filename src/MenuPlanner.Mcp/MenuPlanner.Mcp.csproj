<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>MenuPlanner.Mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MenuPlanner.Infrastructure\MenuPlanner.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="MenuPlanner.Contracts" />
  </ItemGroup>

  <!-- El seed se copia junto al ejecutable: Claude Desktop lo lanza desde cualquier carpeta. -->
  <ItemGroup>
    <None Include="..\..\seed\*.json" Link="seed\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
