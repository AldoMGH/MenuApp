{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receta",
  "description": "Guisado + acompañamientos. Los componentes se porcionan según el plan; los ingredientes fijos no se escalan.",
  "type": "object",
  "required": ["id", "name", "meal", "servings", "cookingMethod", "components"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "title": "Identificador" },
    "name": { "type": "string", "minLength": 1, "title": "Nombre" },
    "meal": { "enum": ["desayuno", "colacion", "comida", "snack", "cena"], "default": "comida", "title": "Tiempo de comida" },
    "servings": { "type": "integer", "minimum": 1, "maximum": 12, "default": 4, "title": "Porciones" },
    "cookingMethod": { "type": "string", "minLength": 1, "title": "Método de cocción" },
    "tags": { "type": "array", "items": { "type": "string" }, "title": "Etiquetas" },
    "laborious": { "type": "boolean", "default": false, "title": "Laborioso" },
    "components": {
      "type": "array",
      "title": "Componentes del plato",
      "items": {
        "type": "object",
        "required": ["group", "ingredients"],
        "properties": {
          "group": { "enum": ["verdura", "proteina", "leguminosa", "cereal", "grasa"] },
          "ingredients": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["ingredientId"],
              "properties": {
                "ingredientId": { "type": "string", "minLength": 1 },
                "share": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
              },
              "additionalProperties": false
            }
          },
          "optional": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      }
    },
    "fixedIngredients": {
      "type": "array",
      "title": "Ingredientes fijos (salsa, condimentos)",
      "items": {
        "type": "object",
        "required": ["ingredientId", "qty", "unit"],
        "properties": {
          "ingredientId": { "type": "string", "minLength": 1 },
          "qty": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "enum": ["g", "ml", "pieza", "taza", "cda", "cdita", "diente", "paquete", "lata"] },
          "note": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "steps": { "type": "array", "items": { "type": "string" }, "title": "Pasos" },
    "source": { "type": "string", "default": "manual", "title": "Origen" },
    "stats": {
      "type": "object",
      "properties": {
        "timesCooked": { "type": "integer", "minimum": 0 },
        "lastCooked": { "type": ["string", "null"], "format": "date-time" },
        "historyCount": { "type": "integer", "minimum": 0 },
        "historyLastCooked": { "type": ["string", "null"], "format": "date-time" },
        "historyMonths": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "totalCount": { "type": "integer", "readOnly": true },
        "latestCooked": { "type": ["string", "null"], "readOnly": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
